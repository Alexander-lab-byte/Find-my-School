# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL (Supabase → Project Settings → Database). DATABASE_URL is the pooled
# connection the app uses; DIRECT_URL is the direct one Prisma migrations use.
DATABASE_URL=
DIRECT_URL=

# Supabase Auth (Project Settings → API). The publishable key replaces the old anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The site's public address, used for the sitemap and share images.
# On Vercel the production URL is used automatically if this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that may approve reviews and handle reports.
ADMIN_EMAILS=
